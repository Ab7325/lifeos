# Supabase wiring — copy this file to .env.local and fill in from
# Supabase Dashboard → Project Settings → API. Then restart `npm run dev`.
# Without these the app runs pure-local (localStorage only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Linked apps. Set these to each app's deployed Vercel URL.
# Left empty, the links are hidden.
VITE_STRONG_URL=
VITE_POKEDEX_URL=
VITE_WOODSHED_URL=
